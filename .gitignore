# Markdown: keep planning/notes files out of the repo.
# README.md is the one exception (it's already tracked and is part of the deliverable).
*.md
!README.md

# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Native projects are generated by `expo prebuild` (CNG) — never commit them
apps/*/android/
apps/*/ios/
.kotlin/
*.orig.*

# Signing / secrets
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env.*

# Test / coverage output
coverage/

# Logs
npm-debug.log*
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
