{
  "name": "streaming-app",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "config",
    "shared"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start -w apps/mobile",
    "tv": "npm run start -w apps/native-tv",
    "mobile:ios": "npm run ios -w apps/mobile --",
    "mobile:android": "npm run android -w apps/mobile --",
    "tv:ios": "npm run ios -w apps/native-tv --",
    "tv:android": "npm run android -w apps/native-tv --",
    "mobile:prebuild": "npm run prebuild -w apps/mobile --",
    "tv:prebuild": "npm run prebuild -w apps/native-tv --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
